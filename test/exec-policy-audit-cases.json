{
  "harmless": [
    "pwd",
    "id",
    "whoami",
    "groups",
    "uname -a",
    "uptime",
    "free -h",
    "nproc",
    "hostname",
    "date +%Y-%m-%d",
    "ps aux | head -10",
    "pgrep -a node | head -5",
    "which node",
    "whereis node",
    "findmnt",
    "lsblk",
    "ls -la /workspace/draft",
    "cat /etc/os-release",
    "head -5 /proc/cpuinfo",
    "wc -l /etc/passwd",
    "stat /workspace/draft",
    "du -sh /workspace/draft",
    "df -h /workspace/draft",
    "readlink -f /workspace",
    "realpath /workspace/draft",
    "grep -i linux /etc/os-release",
    "rg -n name /workspace/openclaw-src/package.json",
    "sha256sum /etc/os-release",
    "cmp /etc/os-release /etc/os-release",
    "find /workspace/openclaw-src -maxdepth 1 -type f -name *.json",
    "ip addr show",
    "ip route show",
    "ss -ltn"
  ],
  "ask": [
    "env",
    "ping -c 1 1.1.1",
    "curl -I https://example.com",
    "docker ps",
    "journalctl -n 20 --no-pager",
    "systemctl status openclaw --no-pager",
    "find /workspace/draft -type f -exec cat {} ;",
    "rg --pre cat test /workspace/draft",
    "printf hi > /workspace/draft/output.txt",
    "cat $(printf /etc/passwd)",
    "cat /workspace/draft/*.txt",
    "du -sh /workspace/draft/*",
    "rg name",
    "find -name *.js"
  ],
  "denyCandidates": [
    "rm -rf /",
    "rm -rf /home/openclaw",
    "mkfs.ext4 /dev/sda",
    "wipefs -a /dev/sda",
    "dd if=/dev/zero of=/dev/sda",
    "shutdown -h now",
    "reboot",
    "systemctl poweroff",
    "chmod -R 777 /",
    "chown -R root:root /",
    "iptables -F",
    "nft flush ruleset"
  ]
}
